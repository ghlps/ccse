<div class="flex justify-center pt-6">
  <button
    id="like-btn"
    type="button"
    class="group cursor-pointer flex items-center gap-2 py-2.5 px-5 bg-white dark:bg-zinc-900 border-2 border-slate-900 dark:border-zinc-700 hover:bg-[#FFC400]/10 dark:hover:bg-[#FFC400]/10 hover:border-[#C60B1E] dark:hover:border-[#FFC400] active:translate-x-[2px] active:translate-y-[2px] shadow-[3px_3px_0px_0px_rgba(0,0,0,0.15)] dark:shadow-[3px_3px_0px_0px_rgba(255,255,255,0.05)] active:shadow-none rounded-none transition-all disabled:opacity-60 disabled:cursor-not-allowed"
  >
    <svg
      id="like-icon"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      class="w-4 h-4 fill-none stroke-slate-700 dark:stroke-zinc-300 stroke-2 group-hover:stroke-[#C60B1E] dark:group-hover:stroke-[#FFC400] transition-colors"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M6.633 10.5c.806 0 1.533-.446 2.031-1.08a9.041 9.041 0 0 1 2.861-2.4c.723-.384 1.35-.956 1.653-1.715a4.498 4.498 0 0 0 .322-1.672V3a.75.75 0 0 1 .75-.75A2.25 2.25 0 0 1 16.5 4.5c0 1.152-.26 2.243-.723 3.218-.266.558.107 1.282.725 1.282h3.126c1.026 0 1.945.694 2.054 1.715.045.422.068.85.068 1.285a11.95 11.95 0 0 1-2.649 7.521c-.388.482-1.005.729-1.622.729H13.48c-.483 0-.964-.078-1.423-.23l-3.114-1.04a4.501 4.501 0 0 0-1.423-.23H6.633"
      ></path>
    </svg>
    <span
      class="text-xs font-black uppercase tracking-wider text-slate-700 dark:text-zinc-300 group-hover:text-[#C60B1E] dark:group-hover:text-[#FFC400] transition-colors"
    >
      Me encanta
    </span>
    <span
      id="like-count"
      class="text-xs font-mono font-bold bg-slate-100 dark:bg-zinc-800 text-slate-900 dark:text-zinc-100 px-2 py-0.5 min-w-[1.75rem] text-center"
      >0</span
    >
  </button>
</div>

<style>
  @keyframes like-pop {
    0% {
      transform: scale(1);
    }
    40% {
      transform: scale(1.3);
    }
    100% {
      transform: scale(1);
    }
  }
  .like-pop {
    animation: like-pop 0.3s ease-out;
  }
</style>

<script>
  interface LikeResponse {
    likes: number;
  }

  interface ErrorResponse {
    error: string;
  }

  const pageId = window.location.pathname;
  const button = document.getElementById("like-btn");
  const countSpan = document.getElementById("like-count");
  const icon = document.getElementById("like-icon");

  async function loadLikes() {
    const res = await fetch(`/api/like?pageId=${encodeURIComponent(pageId)}`);
    if (!res.ok) return;
    const data = await res.json<LikeResponse>();
    if (countSpan) countSpan.textContent = String(data.likes);
  }

  button?.addEventListener("click", async () => {
    button.setAttribute("disabled", "true");
    const res = await fetch("/api/like", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ pageId }),
    });

    if (res.ok) {
      const data = await res.json<LikeResponse>();
      if (countSpan) countSpan.textContent = String(data.likes);
      icon?.setAttribute("fill", "currentColor");
      icon?.classList.add(
        "like-pop",
        "fill-[#C60B1E]",
        "dark:fill-[#FFC400]",
        "stroke-[#C60B1E]",
        "dark:stroke-[#FFC400]",
      );
      setTimeout(() => icon?.classList.remove("like-pop"), 300);
    } else if (res.status === 429) {
      const data = await res.json<ErrorResponse>();
      console.log("Rate limited:", data.error);
    }

    button.removeAttribute("disabled");
  });

  loadLikes();
</script>

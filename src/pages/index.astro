---
import Like from "../components/like.astro";
import { questions, SECTIONS } from "../data/questions";
import "../styles/global.css";
---

<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CCSE Práctica Examen</title>
    <style>
      @keyframes streak-pop {
        0% {
          transform: scale(0) rotate(0deg);
          opacity: 0;
        }
        60% {
          transform: scale(1.15) rotate(var(--tilt, 0deg));
          opacity: 1;
        }
        100% {
          transform: scale(1) rotate(var(--tilt, 0deg));
        }
      }
      .streak-pan {
        animation: streak-pop 0.35s ease-out;
      }
      @keyframes bookmark-pop {
        0% {
          transform: scale(0.6);
        }
        50% {
          transform: scale(1.3);
        }
        100% {
          transform: scale(1.1);
        }
      }
      .bookmark-pop {
        animation: bookmark-pop 0.3s ease-out;
      }
    </style>
  </head>
  <body
    class="bg-slate-100 dark:bg-zinc-950 text-slate-900 dark:text-zinc-100 min-h-screen flex flex-col items-center justify-center p-4 transition-colors duration-200"
  >
    <main
      class="w-full max-w-3xl bg-white dark:bg-zinc-900 border-2 border-slate-900 dark:border-zinc-700 shadow-[8px_8px_0px_0px_rgba(0,0,0,0.15)] dark:shadow-[8px_8px_0px_0px_rgba(255,255,255,0.05)] rounded-none relative overflow-hidden"
    >
      <div class="h-2 w-full flex">
        <div class="h-full w-1/4 bg-[#C60B1E]"></div>
        <div class="h-full w-2/4 bg-[#FFC400]"></div>
        <div class="h-full w-1/4 bg-[#C60B1E]"></div>
      </div>

      <div class="p-6 pb-0 flex justify-between items-center">
        <span
          class="text-xs font-black tracking-widest uppercase text-[#C60B1E] dark:text-[#FFC400]"
        >
          España CCSE
        </span>
        <div class="flex items-center gap-2">
          <a
            id="github"
            href="https://github.com/ghlps/ccse"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 hover:cursor-pointer border border-slate-300 dark:border-zinc-700 hover:bg-slate-100 dark:hover:bg-zinc-800 text-xs font-bold uppercase transition rounded-none flex items-center gap-1.5"
            aria-label="Ver en GitHub"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 16 16"
              class="w-4 h-4 fill-current"
            >
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38
            0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13
            -.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66
            .07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15
            -.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27
            .68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12
            .51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48
            0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
              ></path>
            </svg>
            <span>GitHub</span>
          </a>
          <button
            id="theme-toggle"
            class="p-2 hover:cursor-pointer border border-slate-300 dark:border-zinc-700 hover:bg-slate-100 dark:hover:bg-zinc-800 text-xs font-bold uppercase transition rounded-none flex items-center gap-1.5"
            aria-label="Cambiar tema"
          >
            <span id="theme-toggle-icon">☀️</span>
            <span id="theme-toggle-text">Light</span>
          </button>
        </div>
      </div>

      <div class="p-6 pt-4">
        <section id="menu-view" class="space-y-6">
          <header class="text-center space-y-2">
            <h1
              class="text-4xl font-black text-slate-900 dark:text-white uppercase tracking-tight"
            >
              Práctica Examen <span class="text-[#C60B1E]">CCSE</span>
            </h1>
            <h2
              class="text-lg uppercase w-3/4 text-center items-center mx-auto font-bold px-2"
            >
              Prueba de <span class="text-[#C60B1E]">C</span>onocimientos <span
                class="text-[#FFC400]">C</span
              >onstitucionales y <span class="text-[#C60B1E]">S</span
              >ocioculturales de
              {" "}<span class="text-[#FFC400]">E</span>spaña (CCSE)
            </h2>
            <p class="text-slate-600 dark:text-zinc-400 text-sm font-medium">
              Selecciona una modalidad para comenzar
            </p>
          </header>

          <div class="grid gap-3">
            <button
              id="btn-official"
              class="w-full cursor-pointer py-3.5 px-4 bg-[#C60B1E] hover:bg-[#a00817] text-white font-bold rounded-none transition shadow-sm border border-[#C60B1E]"
            >
              Simulacro Oficial (25 Preguntas)
            </button>
            <button
              id="btn-practice"
              class="w-full cursor-pointer py-3.5 px-4 bg-transparent hover:bg-slate-100 dark:hover:bg-zinc-800 text-slate-700 dark:text-zinc-300 font-bold rounded-none transition border-2 border-dashed border-slate-400 dark:border-zinc-600"
            >
              Modo Libre (Sin Límite)
            </button>
          </div>

          <div class="grid grid-cols-2 gap-2">
            <button
              id="btn-wrong"
              disabled
              class="cursor-not-allowed opacity-40 w-full text-center py-2.5 px-3 bg-rose-50 dark:bg-rose-950/30 hover:bg-rose-100 dark:hover:bg-rose-950/50 text-rose-700 dark:text-rose-300 rounded-none text-sm font-bold border border-rose-300 dark:border-rose-900 transition"
            >
              Falladas (<span id="wrong-count">0</span>)
            </button>
            <button
              id="btn-saved"
              disabled
              class="cursor-not-allowed opacity-40 w-full text-center py-2.5 px-3 bg-amber-50 dark:bg-amber-950/30 hover:bg-amber-100 dark:hover:bg-amber-950/50 text-amber-700 dark:text-amber-300 rounded-none text-sm font-bold border border-amber-300 dark:border-amber-900 transition"
            >
              Guardadas (<span id="saved-count">0</span>)
            </button>
          </div>

          <div class="space-y-3 pt-2">
            <h2
              class="text-xs uppercase font-bold tracking-wider text-slate-500 dark:text-zinc-400 border-b border-slate-200 dark:border-zinc-800 pb-1"
            >
              Por Sección
            </h2>
            <div class="grid gap-2">
              {
                SECTIONS.map((sec) => (
                  <button
                    data-section={sec}
                    class="btn-section cursor-pointer w-full text-left py-2.5 px-4 bg-slate-50 dark:bg-zinc-800/50 hover:bg-slate-200 dark:hover:bg-zinc-800 rounded-none text-sm transition border border-slate-300 dark:border-zinc-700 flex justify-between items-center font-medium"
                  >
                    <span>{sec}</span>
                    <span class="text-xs text-[#C60B1E] dark:text-[#FFC400] font-bold">
                      →
                    </span>
                  </button>
                ))
              }
            </div>
          </div>

          <div
            class="mt-6 pt-4 border-t border-slate-200 dark:border-zinc-800 flex flex-col gap-2 text-xs text-slate-500 dark:text-zinc-400 font-medium"
          >
            <div class="flex flex-col gap-1">
              <div class="flex justify-between">
                <span
                  >Tests completados: <strong
                    id="stat-completed"
                    class="text-slate-900 dark:text-zinc-100 font-bold"
                    >0</strong
                  ></span
                >
                <span
                  >Último resultado: <strong
                    id="stat-last-score"
                    class="text-slate-900 dark:text-zinc-100 font-bold"
                    >N/A</strong
                  ></span
                >
              </div>
              <div class="flex justify-between">
                <span
                  >Prácticas libres: <strong
                    id="stat-practice-completed"
                    class="text-slate-900 dark:text-zinc-100 font-bold"
                    >0</strong
                  ></span
                >
                <span
                  >Mejor sesión: <strong
                    id="stat-practice-best"
                    class="text-slate-900 dark:text-zinc-100 font-bold"
                    >N/A</strong
                  ></span
                >
              </div>
              <div class="flex justify-center">
                <span
                  >🔥 Mejor racha: <strong
                    id="stat-practice-best-streak"
                    class="text-slate-900 dark:text-zinc-100 font-bold"
                    >0</strong
                  ></span
                >
              </div>
            </div>
            <a
              href="https://github.com/ghlps/ccse"
              target="_blank"
              rel="noopener noreferrer"
              class="text-center py-2 border border-dashed border-slate-300 dark:border-zinc-700 hover:bg-slate-50 dark:hover:bg-zinc-800/50 transition uppercase tracking-wide font-bold text-[10px]"
            >
              Contribuye en GitHub
            </a>
          </div>
        </section>

        <section id="quiz-view" class="hidden space-y-6">
          <header
            class="flex items-center justify-between text-sm text-slate-500 dark:text-zinc-400 border-b border-slate-200 dark:border-zinc-800 pb-3 font-semibold"
          >
            <span
              id="quiz-category"
              class="text-[#C60B1E] dark:text-[#FFC400] uppercase tracking-wide"
            >
              Cargando...
            </span>
            <div class="flex items-center gap-3">
              <button
                id="btn-bookmark"
                type="button"
                class="cursor-pointer p-1 text-slate-400 dark:text-zinc-500 hover:text-slate-900 dark:hover:text-zinc-100 transition-colors"
                aria-label="Guardar pregunta para repasar luego"
                title="Guardar para repasar luego"
              >
                <svg
                  id="bookmark-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"
                  ></path>
                </svg>
              </button>
              <span
                id="quiz-progress"
                class="bg-slate-200 dark:bg-zinc-800 text-slate-800 dark:text-zinc-200 px-2 py-0.5 text-xs font-mono"
                >0/0</span
              >
            </div>
          </header>

          <div
            id="streak-zone"
            class="hidden items-center justify-end gap-1.5 -mt-1 flex-nowrap"
          >
            <div
              id="streak-stack"
              class="flex flex-nowrap items-center justify-end gap-0.5 overflow-hidden"
            >
            </div>
            <p
              id="streak-label"
              class="text-xs font-black uppercase tracking-wider text-[#C60B1E] dark:text-[#FFC400] whitespace-nowrap shrink-0"
            >
            </p>
          </div>

          <div class="space-y-4">
            <h2
              id="quiz-question"
              class="text-lg font-bold text-slate-900 dark:text-zinc-100 leading-snug"
            >
            </h2>
            <div id="quiz-options" class="grid gap-2.5"></div>

            <div id="comment-toggle-wrap">
              <button
                id="btn-toggle-comment"
                disabled
                class="cursor-not-allowed text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-zinc-600 flex items-center gap-1 transition-colors"
              >
                <span id="toggle-comment-icon">▸</span>
                <span>Ver explicación</span>
              </button>
            </div>

            <div
              id="quiz-comment"
              class="hidden text-sm font-medium leading-relaxed bg-slate-50 dark:bg-zinc-800/60 border border-slate-300 dark:border-zinc-700 px-4 py-3 text-slate-700 dark:text-zinc-300"
            >
            </div>
          </div>

          <div
            class="flex justify-between items-center pt-4 border-t border-slate-200 dark:border-zinc-800"
          >
            <button
              id="btn-exit"
              class="text-xs cursor-pointer font-bold uppercase tracking-wider text-slate-500 hover:text-slate-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition"
              >← Salir</button
            >
            <div class="h-10 flex items-center gap-2">
              <button
                id="btn-repeat"
                class="hidden cursor-pointer px-4 py-2.5 bg-transparent border-2 border-slate-300 dark:border-zinc-700 hover:bg-slate-100 dark:hover:bg-zinc-800 text-slate-700 dark:text-zinc-300 text-sm font-bold rounded-none transition uppercase tracking-wider"
              >
                Repetir
              </button>
              <button
                id="btn-next"
                class="px-6 py-2.5 bg-[#C60B1E] hover:bg-[#a00817] text-white text-sm font-bold rounded-none transition uppercase tracking-wider shadow-sm"
              >
                Siguiente
              </button>
            </div>
          </div>
        </section>

        <section id="results-view" class="hidden text-center space-y-6 py-4">
          <div class="space-y-3">
            <h2 class="text-2xl font-black uppercase tracking-tight">
              ¡Test Finalizado!
            </h2>
            <p
              id="results-summary"
              class="text-4xl font-black text-[#C60B1E] dark:text-[#FFC400]"
            >
            </p>
            <p
              id="results-feedback"
              class="text-sm font-medium text-slate-600 dark:text-zinc-400"
            >
            </p>
          </div>

          <button
            id="btn-restart"
            class="w-full py-3.5 px-4 bg-[#C60B1E] hover:bg-[#a00817] text-white font-bold rounded-none transition shadow-sm border border-[#C60B1E]"
          >
            Volver al Inicio
          </button>
        </section>
        <Like />
      </div>
    </main>

    <script define:vars={{ allQuestions: questions }}>
      let activeQuestions = [];
      let practicePool = [];
      let currentIndex = 0;
      let score = 0;
      let selectedOption = null;
      let isPracticeMode = false;
      let answeredInSession = 0;
      let streak = 0;
      let bestStreakThisSession = 0;
      let currentOptionOrder = [];

      // Theme logic
      const themeToggleBtn = document.getElementById("theme-toggle");
      const themeToggleIcon = document.getElementById("theme-toggle-icon");
      const themeToggleText = document.getElementById("theme-toggle-text");

      const commentToggleWrap = document.getElementById("comment-toggle-wrap");
      const btnToggleComment = document.getElementById("btn-toggle-comment");
      const toggleCommentIcon = document.getElementById("toggle-comment-icon");
      const btnRepeat = document.getElementById("btn-repeat");

      function applyTheme(theme) {
        if (theme === "dark") {
          document.documentElement.classList.add("dark");
          themeToggleIcon.textContent = "☀️";
          themeToggleText.textContent = "Light";
        } else {
          document.documentElement.classList.remove("dark");
          themeToggleIcon.textContent = "🌙";
          themeToggleText.textContent = "Dark";
        }
      }

      const initialTheme = localStorage.getItem("ccse_theme") || "dark";
      applyTheme(initialTheme);

      themeToggleBtn.addEventListener("click", () => {
        const isDark = document.documentElement.classList.contains("dark");
        const nextTheme = isDark ? "light" : "dark";
        localStorage.setItem("ccse_theme", nextTheme);
        applyTheme(nextTheme);
      });

      // DOM Elements
      const quizComment = document.getElementById("quiz-comment");
      const menuView = document.getElementById("menu-view");
      const quizView = document.getElementById("quiz-view");
      const resultsView = document.getElementById("results-view");

      const quizCategory = document.getElementById("quiz-category");
      const quizProgress = document.getElementById("quiz-progress");
      const quizQuestion = document.getElementById("quiz-question");
      const quizOptions = document.getElementById("quiz-options");
      const buttonLike = document.getElementById("like");
      const buttonGithub = document.getElementById("github");
      const btnNext = document.getElementById("btn-next");
      const btnBookmark = document.getElementById("btn-bookmark");
      const btnWrong = document.getElementById("btn-wrong");
      const btnSaved = document.getElementById("btn-saved");
      const wrongCountEl = document.getElementById("wrong-count");
      const savedCountEl = document.getElementById("saved-count");

      const statCompleted = document.getElementById("stat-completed");
      const statLastScore = document.getElementById("stat-last-score");
      const statPracticeCompleted = document.getElementById(
        "stat-practice-completed",
      );
      const statPracticeBest = document.getElementById("stat-practice-best");
      const statPracticeBestStreak = document.getElementById(
        "stat-practice-best-streak",
      );
      const streakZone = document.getElementById("streak-zone");
      const streakStack = document.getElementById("streak-stack");
      const streakLabel = document.getElementById("streak-label");

      // LocalStorage Helpers
      function loadStats() {
        try {
          const stats = JSON.parse(
            localStorage.getItem("ccse_stats") ||
              '{"completed": 0, "lastScore": "N/A"}',
          );
          statCompleted.textContent = stats.completed;
          statLastScore.textContent = stats.lastScore;
        } catch (err) {
          console.error("No se pudieron cargar las estadísticas:", err);
          statCompleted.textContent = "0";
          statLastScore.textContent = "N/A";
        }
      }

      function saveStats(correct, total) {
        try {
          const stats = JSON.parse(
            localStorage.getItem("ccse_stats") ||
              '{"completed": 0, "lastScore": "N/A"}',
          );
          stats.completed += 1;
          const passed = correct >= 15;
          const statusText = passed ? "APROBADO" : "NO APTO";
          stats.lastScore = `${correct}/${total} (${statusText})`;
          localStorage.setItem("ccse_stats", JSON.stringify(stats));
        } catch (err) {
          console.error("No se pudieron guardar las estadísticas:", err);
        }
        loadStats();
      }

      function loadPracticeStats() {
        try {
          const stats = JSON.parse(
            localStorage.getItem("ccse_practice_stats") ||
              '{"completed": 0, "best": "N/A", "bestStreak": 0}',
          );
          statPracticeCompleted.textContent = stats.completed;
          statPracticeBest.textContent = stats.best;
          statPracticeBestStreak.textContent = stats.bestStreak || 0;
        } catch (err) {
          console.error(
            "No se pudieron cargar las estadísticas de práctica:",
            err,
          );
          statPracticeCompleted.textContent = "0";
          statPracticeBest.textContent = "N/A";
          statPracticeBestStreak.textContent = "0";
        }
      }

      function savePracticeStats(correct, total, sessionBestStreak = 0) {
        try {
          const stats = JSON.parse(
            localStorage.getItem("ccse_practice_stats") ||
              '{"completed": 0, "best": "N/A", "bestStreak": 0}',
          );
          stats.completed += 1;

          const accuracy = total > 0 ? correct / total : 0;

          let prevBestCorrect = -1;
          let prevBestAccuracy = -1;

          if (stats.best !== "N/A") {
            const match = /(\d+)\/(\d+)/.exec(stats.best);
            if (match) {
              prevBestCorrect = Number(match[1]);
              prevBestAccuracy = prevBestCorrect / Number(match[2]);
            }
          }

          if (
            accuracy > prevBestAccuracy ||
            (accuracy === prevBestAccuracy && correct >= prevBestCorrect)
          ) {
            stats.best = `${correct}/${total}`;
          }

          if (sessionBestStreak > (stats.bestStreak || 0)) {
            stats.bestStreak = sessionBestStreak;
          }

          localStorage.setItem("ccse_practice_stats", JSON.stringify(stats));
        } catch (err) {
          console.error(
            "No se pudieron guardar las estadísticas de práctica:",
            err,
          );
        }
        loadPracticeStats();
      }

      // Saved questions ("read later") + wrong questions tracking
      function getQuestionIndex(q) {
        return allQuestions.indexOf(q);
      }

      function loadIndexSet(key) {
        try {
          const arr = JSON.parse(localStorage.getItem(key) || "[]");
          return new Set(Array.isArray(arr) ? arr : []);
        } catch (err) {
          console.error(`No se pudo cargar ${key}:`, err);
          return new Set();
        }
      }

      function persistIndexSet(key, set) {
        try {
          localStorage.setItem(key, JSON.stringify([...set]));
        } catch (err) {
          console.error(`No se pudo guardar ${key}:`, err);
        }
      }

      let savedQuestions = loadIndexSet("ccse_saved_questions");
      let wrongQuestions = loadIndexSet("ccse_wrong_questions");

      function refreshCollectionButtons() {
        wrongCountEl.textContent = wrongQuestions.size;
        savedCountEl.textContent = savedQuestions.size;

        const hasWrong = wrongQuestions.size > 0;
        const hasSaved = savedQuestions.size > 0;

        btnWrong.disabled = !hasWrong;
        btnWrong.classList.toggle("opacity-40", !hasWrong);
        btnWrong.classList.toggle("cursor-not-allowed", !hasWrong);
        btnWrong.classList.toggle("cursor-pointer", hasWrong);

        btnSaved.disabled = !hasSaved;
        btnSaved.classList.toggle("opacity-40", !hasSaved);
        btnSaved.classList.toggle("cursor-not-allowed", !hasSaved);
        btnSaved.classList.toggle("cursor-pointer", hasSaved);
      }

      function updateBookmarkIcon() {
        const q = activeQuestions[currentIndex];
        const idx = getQuestionIndex(q);
        const isSaved = savedQuestions.has(idx);
        const bookmarkIcon = document.getElementById("bookmark-icon");

        if (isSaved) {
          bookmarkIcon.setAttribute("fill", "currentColor");
          btnBookmark.classList.add("text-[#C60B1E]", "dark:text-[#FFC400]");
          btnBookmark.classList.remove("text-slate-400", "dark:text-zinc-500");
        } else {
          bookmarkIcon.setAttribute("fill", "none");
          btnBookmark.classList.remove("text-[#C60B1E]", "dark:text-[#FFC400]");
          btnBookmark.classList.add("text-slate-400", "dark:text-zinc-500");
        }

        btnBookmark.title = isSaved
          ? "Quitar de guardadas"
          : "Guardar para repasar luego";
      }

      btnBookmark.onclick = () => {
        const q = activeQuestions[currentIndex];
        const idx = getQuestionIndex(q);
        if (idx === -1) return;

        if (savedQuestions.has(idx)) {
          savedQuestions.delete(idx);
        } else {
          savedQuestions.add(idx);
          btnBookmark.classList.remove("bookmark-pop");
          void btnBookmark.offsetWidth;
          btnBookmark.classList.add("bookmark-pop");
        }

        persistIndexSet("ccse_saved_questions", savedQuestions);
        updateBookmarkIcon();
        refreshCollectionButtons();
      };

      btnWrong.onclick = () => {
        if (wrongQuestions.size === 0) return;
        const qs = allQuestions.filter((_, i) => wrongQuestions.has(i));
        startQuiz(shuffle(qs), "Repaso: Falladas", true);
      };

      btnSaved.onclick = () => {
        if (savedQuestions.size === 0) return;
        const qs = allQuestions.filter((_, i) => savedQuestions.has(i));
        startQuiz(shuffle(qs), "Repaso: Guardadas", true);
      };

      function shuffle(array) {
        return [...array].sort(() => Math.random() - 0.5);
      }

      function startQuiz(questionsList, categoryName, practiceMode = false) {
        activeQuestions = questionsList;
        practicePool = practiceMode ? questionsList : null;
        currentIndex = 0;
        score = 0;
        answeredInSession = 0;
        streak = 0;
        bestStreakThisSession = 0;
        isPracticeMode = practiceMode;
        quizCategory.textContent = categoryName;

        menuView.classList.add("hidden");
        resultsView.classList.add("hidden");
        quizView.classList.remove("hidden");

        if (isPracticeMode) {
          streakZone.classList.remove("hidden");
          streakZone.classList.add("flex");
        } else {
          streakZone.classList.add("hidden");
          streakZone.classList.remove("flex");
        }
        renderStreak();

        renderQuestion();
      }

      function generateOfficialExam() {
        const govKeywords = [
          "gobierno",
          "legislacion",
          "constitucion",
          "ciudadania",
          "derechos",
          "instituciones",
        ];

        const isGovSection = (sectionName) => {
          const lower = (sectionName || "").toLowerCase();
          return govKeywords.some((kw) => lower.includes(kw));
        };

        const govQuestions = allQuestions.filter((q) =>
          isGovSection(q.section),
        );
        const cultureQuestions = allQuestions.filter(
          (q) => !isGovSection(q.section),
        );

        const selectedGov = shuffle(govQuestions).slice(0, 15);
        const selectedCulture = shuffle(cultureQuestions).slice(0, 10);

        return shuffle([...selectedGov, ...selectedCulture]);
      }

      function renderQuestion() {
        selectedOption = null;
        btnNext.classList.add("hidden");
        buttonLike.classList.add("hidden");
        buttonGithub.classList.add("hidden");

        btnNext.classList.add("invisible");
        btnRepeat.classList.add("hidden");

        quizComment.classList.add("hidden");
        quizComment.textContent = "";

        btnToggleComment.disabled = true;
        btnToggleComment.classList.add(
          "cursor-not-allowed",
          "text-slate-400",
          "dark:text-zinc-600",
        );
        btnToggleComment.classList.remove(
          "cursor-pointer",
          "text-[#C60B1E]",
          "dark:text-[#FFC400]",
          "hover:underline",
        );
        toggleCommentIcon.textContent = "▸";

        const q = activeQuestions[currentIndex];

        quizProgress.textContent = isPracticeMode
          ? `Pregunta ${answeredInSession + 1}`
          : `${currentIndex + 1}/${activeQuestions.length}`;
        quizQuestion.textContent = q.question;
        quizOptions.innerHTML = "";

        currentOptionOrder = shuffle(q.options.map((_, i) => i));

        currentOptionOrder.forEach((origIdx, displayIdx) => {
          const opt = q.options[origIdx];
          const btn = document.createElement("button");
          btn.className =
            "w-full text-left py-3 px-4 rounded-none bg-slate-50 dark:bg-zinc-800/60 hover:bg-slate-200 dark:hover:bg-zinc-800 border border-slate-300 dark:border-zinc-700 transition text-sm flex items-center justify-between font-medium";
          btn.innerHTML = `<span>${opt}</span><span class="status-icon font-bold w-5 shrink-0 text-center inline-block whitespace-nowrap"></span>`;
          btn.onclick = () => selectOption(displayIdx);
          quizOptions.appendChild(btn);
        });

        updateBookmarkIcon();
      }

      function renderStreak() {
        streakStack.innerHTML = "";

        const maxVisible = 5; // was 12 — too many for mobile width
        const visibleCount = Math.min(streak, maxVisible);

        for (let i = 0; i < visibleCount; i++) {
          const pan = document.createElement("div");
          pan.textContent = "🥘";
          pan.className =
            "streak-pan text-base leading-none drop-shadow-md w-5 h-5 flex items-center justify-center shrink-0";
          streakStack.appendChild(pan);
        }

        if (streak > maxVisible) {
          const badge = document.createElement("div");
          badge.textContent = `+${streak - maxVisible}`;
          badge.className =
            "streak-pan text-xs font-black text-[#C60B1E] dark:text-[#FFC400] flex items-center shrink-0";
          streakStack.appendChild(badge);
        }

        streakLabel.textContent =
          streak > 0 ? `🔥 ${streak}` : "Responde bien para empezar la racha";
      }

      function selectOption(displayIdx) {
        if (selectedOption !== null) return;
        selectedOption = displayIdx;

        btnNext.classList.remove("hidden");
        btnRepeat.classList.remove("hidden");

        const q = activeQuestions[currentIndex];
        const buttons = quizOptions.querySelectorAll("button");
        const selectedOrigIdx = currentOptionOrder[displayIdx];

        buttons.forEach((btn, i) => {
          btn.disabled = true;
          const origIdx = currentOptionOrder[i];

          if (origIdx === q.correctAnswer) {
            btn.classList.add(
              "bg-green-400!",
              "dark:bg-emerald-950/80",
              "border-emerald-600",
              "dark:border-emerald-500",
              "text-emerald-900!",
              "dark:text-emerald-200",
            );
            btn.querySelector(".status-icon").textContent = "✓";
          } else if (i === selectedOption) {
            btn.classList.add(
              "bg-rose-100",
              "dark:bg-rose-950/80",
              "border-rose-600",
              "dark:border-rose-500",
              "text-rose-900",
              "dark:text-rose-200",
            );
            btn.querySelector(".status-icon").textContent = "✗";
          }

          btnNext.classList.remove("invisible");
        });

        if (q.comment) {
          quizComment.textContent = q.comment;
          btnToggleComment.disabled = false;
          btnToggleComment.classList.remove(
            "cursor-not-allowed",
            "text-slate-400",
            "dark:text-zinc-600",
          );
          btnToggleComment.classList.add(
            "cursor-pointer",
            "text-[#C60B1E]",
            "dark:text-[#FFC400]",
            "hover:underline",
          );
        }

        answeredInSession++;
        const qIndex = getQuestionIndex(q);

        if (selectedOrigIdx === q.correctAnswer) {
          score++;
          wrongQuestions.delete(qIndex);
          if (isPracticeMode) {
            streak++;
            if (streak > bestStreakThisSession) bestStreakThisSession = streak;
          }
        } else {
          if (qIndex !== -1) wrongQuestions.add(qIndex);
          if (isPracticeMode) streak = 0;
        }
        persistIndexSet("ccse_wrong_questions", wrongQuestions);
        refreshCollectionButtons();

        if (isPracticeMode) renderStreak();

        btnNext.classList.remove("hidden");
      }
      function showResults() {
        quizView.classList.add("hidden");
        resultsView.classList.remove("hidden");

        const total = activeQuestions.length;
        const isPassed = score >= 15;

        document.getElementById("results-summary").textContent =
          `${score} / ${total}`;
        document.getElementById("results-feedback").textContent = isPassed
          ? "¡APTO! Has superado el test (mínimo requerido: 15/25 aciertos)."
          : "NO APTO. Necesitas al menos 15 aciertos sobre 25.";

        saveStats(score, total);
      }

      function showPracticeResults() {
        quizView.classList.add("hidden");
        resultsView.classList.remove("hidden");

        document.getElementById("results-summary").textContent =
          `${score} / ${answeredInSession}`;
        document.getElementById("results-feedback").textContent =
          answeredInSession > 0
            ? `Sesión libre finalizada. Mejor racha: ${bestStreakThisSession} 🔥`
            : "Saliste sin responder ninguna pregunta.";

        if (answeredInSession > 0) {
          savePracticeStats(score, answeredInSession, bestStreakThisSession);
        }
      }

      document.getElementById("btn-official").onclick = () => {
        startQuiz(generateOfficialExam(), "Examen Oficial (25 preguntas)");
      };

      btnRepeat.onclick = () => {
        renderQuestion();
      };

      document.getElementById("btn-practice").onclick = () => {
        startQuiz(shuffle(allQuestions), "Modo Libre", true);
      };

      btnToggleComment.onclick = () => {
        const isHidden = quizComment.classList.toggle("hidden");
        toggleCommentIcon.textContent = isHidden ? "▸" : "▾";
      };

      document.querySelectorAll(".btn-section").forEach((btn) => {
        btn.onclick = () => {
          const sec = btn.getAttribute("data-section");
          const filtered = allQuestions.filter((q) => q.section === sec);
          startQuiz(shuffle(filtered), sec);
        };
      });

      btnNext.onclick = () => {
        currentIndex++;
        if (currentIndex < activeQuestions.length) {
          renderQuestion();
        } else if (isPracticeMode && practicePool && practicePool.length > 0) {
          activeQuestions = shuffle(practicePool);
          currentIndex = 0;
          renderQuestion();
        } else {
          showResults();
        }
      };

      document.getElementById("btn-exit").onclick = () => {
        if (isPracticeMode) {
          showPracticeResults();
          return;
        }
        quizView.classList.add("hidden");
        menuView.classList.remove("hidden");
        buttonLike.classList.remove("hidden");
        buttonGithub.classList.remove("hidden");
      };

      document.getElementById("btn-restart").onclick = () => {
        isPracticeMode = false;
        resultsView.classList.add("hidden");
        menuView.classList.remove("hidden");
        buttonLike.classList.remove("hidden");
        buttonGithub.classList.remove("hidden");
      };

      loadStats();
      loadPracticeStats();
      refreshCollectionButtons();
    </script>
  </body>
</html>
